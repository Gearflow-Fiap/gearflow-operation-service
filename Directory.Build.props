<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildProjectExtension)' == '.csproj'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel Condition="'$(MSBuildProjectExtension)' == '.csproj'">10.0</AnalysisLevel>
    <EnableNETAnalyzers Condition="'$(MSBuildProjectExtension)' == '.csproj'">true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild Condition="'$(MSBuildProjectExtension)' == '.csproj'">true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
