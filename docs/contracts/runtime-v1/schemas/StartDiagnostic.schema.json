{
  "type": "object",
  "properties": {
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "messageId": {
      "type": "string",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "occurredOn": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\\u002B00:00)$"
    },
    "vehicleId": {
      "type": "string",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "serviceOrderCode": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "requestedJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string",
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "catalogJobId": {
            "type": "string",
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          }
        },
        "required": [
          "lineId",
          "catalogJobId"
        ]
      },
      "maxItems": 200,
      "minItems": 1
    },
    "requestedParts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string",
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "partId": {
            "type": "string",
            "format": "uuid",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "multipleOf": 0.001
          }
        },
        "required": [
          "lineId",
          "partId",
          "quantity"
        ]
      },
      "maxItems": 200
    }
  },
  "required": [
    "correlationId",
    "messageId",
    "occurredOn",
    "vehicleId",
    "serviceOrderCode",
    "requestedJobs",
    "requestedParts"
