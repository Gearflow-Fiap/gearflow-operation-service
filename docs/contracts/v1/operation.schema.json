    "CommercialLine": {
      "type": "object",
      "properties": {
        "lineId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "itemType": {
          "enum": [
            "Labor",
            "Part",
            "Consumable"
          ]
        },
        "itemId": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.001
        },
        "unitPriceCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lineTotalCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "lineId",
        "itemType",
        "itemId",
        "name",
        "quantity",
        "unitPriceCents",
        "lineTotalCents"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "itemType": {
                "const": "Labor"
              }
            }
          },
          "then": {
            "properties": {
              "quantity": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "itemType": {
                "const": "Part"
              }
            }
          },
          "then": {
            "properties": {
              "quantity": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
