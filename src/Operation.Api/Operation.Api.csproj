<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>../../docker-compose.dcproj</DockerComposeProjectPath>
    <DockerfilePath>Dockerfile</DockerfilePath>
    <DockerfileContext>../..</DockerfileContext>
    <DockerDebuggeeProgram>dotnet</DockerDebuggeeProgram>
    <DockerDebuggeeArguments>/app/api/Operation.Api.dll</DockerDebuggeeArguments>
    <DockerDebuggeeWorkingDirectory>/app/api</DockerDebuggeeWorkingDirectory>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Operation.Infrastructure/Operation.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
</Project>
