<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Código gerado pela biblioteca Microsoft.AspNetCore.OpenApi, não código do serviço. -->
          <ExcludeByFile>**/OpenApiXmlCommentSupport.generated.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
